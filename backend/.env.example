APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://aspio:aspio@localhost:55432/aspio?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTO_MIGRATE=true
UPLOAD_DIR=./data/uploads

# Admin sessions are stored server-side and can be revoked.
SESSION_TTL=24h

# Used to pseudonymize lead IP addresses. Generate a unique random value of at least 32 characters for production.
IP_HASH_SECRET=replace_with_a_random_32_character_secret

# Lead delivery. Leads are saved even when the email service is temporarily down.
RESEND_API_KEY=re_replace_me
LEAD_RECIPIENT_EMAIL=amanuel.t@aspio.se
LEAD_FROM_EMAIL=Aspio Leads <onboarding@resend.dev>

# Optional future CRM integration. The same durable job queue retries this webhook.
# CRM_WEBHOOK_URL=https://crm.example.com/webhooks/aspio-leads
# CRM_WEBHOOK_TOKEN=replace_me

# Used only by: go run ./cmd/admin -email admin@example.com -name "Admin"
# ASPIO_ADMIN_PASSWORD=replace_with_a_long_password
